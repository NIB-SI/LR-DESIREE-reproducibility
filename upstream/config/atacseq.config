process {
  resourceLimits = [
    cpus: 8,
    time: 24.h,
    memory: 256.GB
  ]

  withName: 'STAR_GENOMEGENERATE'{
        cpus   = 8
        memory = 256.GB
        time   = 16.h
    }

  withName: 'BWA_MEM' {
            ext.args   = {
                [
                    '-M -a', // -a: report all alignments (needed with --keep_multi_map)
                    params.bwa_min_score ? " -T ${params.bwa_min_score}" : '',
                    meta.read_group ? "-R ${meta.read_group}": ''
                ].join(' ').trim()
            }
            ext.args2  = '-bhS -F 0x0100 -O BAM' // -F 0x0100: drop secondary alignments
            ext.prefix = { "${meta.id}.Lb" }
        }
}
